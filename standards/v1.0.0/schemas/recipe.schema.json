{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-gastronomic.local/schemas/recipe.schema.json",
  "title": "Atlas Gastronomic Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipe_id",
    "version",
    "title",
    "status",
    "yield",
    "ingredients",
    "steps",
    "sources"
  ],
  "properties": {
    "recipe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "alternate_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "culinary_tradition": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "idea",
        "researching",
        "draft",
        "technical_review",
        "editorial_review",
        "needs_revision",
        "human_approved",
        "published",
        "archived"
      ]
    },
    "yield": {
      "type": "object",
      "required": [
        "quantity",
        "unit"
      ],
      "properties": {
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string"
        },
        "approx_final_weight_g": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "active_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "difficulty": {
      "enum": [
        "easy",
        "moderate",
        "advanced",
        null
      ]
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ingredient_id",
          "name",
          "quantity",
          "unit",
          "preparation"
        ],
        "properties": {
          "ingredient_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "preparation": {
            "type": [
              "string",
              "null"
            ]
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "optional": {
            "type": "boolean",
            "default": false
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_number",
          "instruction"
        ],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 5
          },
          "duration_minutes": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "temperature_c": {
            "type": [
              "number",
              "null"
            ]
          },
          "heat_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "success_cue": {
            "type": [
              "string",
              "null"
            ]
          },
          "ingredient_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storage": {
      "type": [
        "string",
        "null"
      ]
    },
    "nutrition_estimate": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "basis": {
          "type": "string"
        },
        "per_serving": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "method_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "confidence",
          "source_ids"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "documented",
              "widely_attested",
              "editorial_interpretation",
              "uncertain"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "editorial_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "revision_required"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}