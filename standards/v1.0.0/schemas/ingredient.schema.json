{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-gastronomic.local/schemas/ingredient.schema.json",
  "title": "Atlas Gastronomic Ingredient",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ingredient_id",
    "canonical_name",
    "category"
  ],
  "properties": {
    "ingredient_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 2
    },
    "localized_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "food_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "common_units": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "density_g_per_ml": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storage_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "substitution_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "editorial_status": {
      "enum": [
        "unverified",
        "reviewed",
        "approved"
      ]
    }
  }
}